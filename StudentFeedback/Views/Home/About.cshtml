@{
    ViewBag.Title = "About";
}
<main aria-labelledby="title" class="my-4">
    <h2 id="title" class="fw-bold text-success">About EduPulse Feedback System</h2>
    <p class="lead">ASP.NET MVC Student Evaluation Portal</p>

    <div class="card p-4 mt-3 shadow-sm border">
        <p>This laboratory practical implements a full-featured feedback collection workflow:</p>
        <ul>
            <li>Strongly-typed <code>Feedback</code> model with server &amp; client-side validation</li>
            <li>AntiForgeryToken protection on HTTP POST submissions</li>
            <li>Custom shared layout views and modular partial headers</li>
            <li>Session-based data storage and aggregated tabular reports</li>
        </ul>
        <p class="mb-0 text-muted">Created for .NET Web Application Development Laboratory.</p>
    </div>
</main>