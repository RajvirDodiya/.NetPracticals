@{
    ViewBag.Title = "Portal Dashboard";
    Layout = "~/Views/Shared/_LayoutView.cshtml";
}

<div class="page-card">
    @Html.Partial("~/Views/Shared/_StudentInfo.cshtml")

    <div class="alert alert-info border-0 rounded-3 mb-4" style="background-color: #f0fdfa; color: #115e59;">
        <i class="bi bi-info-circle-fill me-2"></i>
        Welcome to the EduPulse Academic Evaluation System. Your honest feedback plays a critical role in refining teaching methods, syllabus pace, and lab resources.
    </div>

    <div class="row g-4 mt-1">
        <div class="col-md-6">
            <div class="p-4 rounded-3 h-100 border bg-light d-flex flex-column justify-content-between">
                <div>
                    <div class="d-flex align-items-center mb-3">
                        <div class="p-2 rounded-circle bg-white text-success shadow-sm me-3">
                            <i class="bi bi-pencil-fill fs-4"></i>
                        </div>
                        <h4 class="mb-0 fw-bold" style="color: #0f766e;">Submit Course Feedback</h4>
                    </div>
                    <p class="text-secondary">
                        Provide detailed feedback on lectures, subject comprehension, faculty guidance, and practical sessions.
                    </p>
                </div>
                <div class="mt-3">
                    <a href="@Url.Action("Create", "Feedback")" class="btn btn-brand w-100">
                        <i class="bi bi-plus-circle me-1"></i> Launch Feedback Form
                    </a>
                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="p-4 rounded-3 h-100 border bg-light d-flex flex-column justify-content-between">
                <div>
                    <div class="d-flex align-items-center mb-3">
                        <div class="p-2 rounded-circle bg-white text-primary shadow-sm me-3">
                            <i class="bi bi-view-list fs-4"></i>
                        </div>
                        <h4 class="mb-0 fw-bold" style="color: #0f766e;">Explore Responses</h4>
                    </div>
                    <p class="text-secondary">
                        Inspect recorded ratings and observational comments submitted by fellow students across different modules.
                    </p>
                </div>
                <div class="mt-3">
                    <a href="@Url.Action("List", "Feedback")" class="btn btn-outline-secondary w-100" style="border-radius: 10px; padding: 11px 24px; font-weight: 600;">
                        <i class="bi bi-card-checklist me-1"></i> View Submitted Responses
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>