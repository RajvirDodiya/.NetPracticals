@{
    ViewBag.Title = "Home";
    Layout = "~/Views/Shared/_LayoutView.cshtml";
}

@Html.Partial("~/Views/Shared/_StudentInfo.cshtml")

<div class="card shadow-sm p-4 border-0">
    <h4 class="mb-3">Welcome to Feedback Portal</h4>
    <p class="text-muted">Please provide your valuable feedback for your subjects and faculty.</p>
    <div class="d-flex gap-3 mt-2">
        <a href="@Url.Action("Create", "Feedback")" class="btn btn-primary">
            Submit Feedback
        </a>
        <a href="@Url.Action("List", "Feedback")" class="btn btn-outline-primary">
            View All Feedback
        </a>
    </div>
</div>