@model IEnumerable<StudentFeedback.Models.Feedback>

@{
    ViewBag.Title = "Feedback List";
    Layout = "~/Views/Shared/_LayoutView.cshtml";
}

@Html.Partial("~/Views/Shared/_StudentInfo.cshtml")

<div class="card shadow-sm p-4 border-0">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h5 class="mb-0 text-primary">Submitted Feedback</h5>
        <span class="badge bg-secondary">Total: @Model.Count()</span>
    </div>

    <div class="table-responsive">
        <table class="table table-bordered table-striped align-middle mb-0">
            <thead class="table-dark">
                <tr>
                    <th>Enrollment No</th>
                    <th>Student Name</th>
                    <th>Subject</th>
                    <th>Rating</th>
                    <th>Comments</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.EnrollmentNumber</td>
                        <td>@item.StudentName</td>
                        <td>@item.SubjectName</td>
                        <td><span class="badge bg-success">@item.Rating / 5</span></td>
                        <td>@item.Comments</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="mt-3">
        <a href="@Url.Action("Create", "Feedback")" class="btn btn-primary">Add Another Feedback</a>
        <a href="@Url.Action("Index", "Feedback")" class="btn btn-secondary ms-2">Home</a>
    </div>
</div>