@model IEnumerable<StudentFeedback.Models.Feedback>

@{
    ViewBag.Title = "Evaluation Responses";
    Layout = "~/Views/Shared/_LayoutView.cshtml";
}

<div class="page-card">
    @Html.Partial("~/Views/Shared/_StudentInfo.cshtml")

    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <h4 class="mb-0 fw-bold" style="color: #0f766e;">Recorded Submissions</h4>
            <small class="text-muted">Overview of evaluations registered in this session</small>
        </div>

        <span class="badge rounded-pill px-3 py-2 fs-6" style="background-color: #0f766e; color: #ffffff;">
            <i class="bi bi-people-fill me-1"></i> Responses Logged: @Model.Count()
        </span>
    </div>

    <div class="table-responsive">
        <table class="table table-bordered table-hover feedback-table mb-0">
            <thead>
                <tr>
                    <th>Enrollment No.</th>
                    <th>Student Name</th>
                    <th>Course / Subject</th>
                    <th>Rating</th>
                    <th>Observations &amp; Remarks</th>
                </tr>
            </thead>

            <tbody>
                @if (Model.Any())
                {
                    foreach (var item in Model)
                    {
                        <tr>
                            <td class="fw-semibold text-secondary">
                                <i class="bi bi-person-badge me-1"></i>@Html.DisplayFor(m => item.EnrollmentNumber)
                            </td>
                            <td class="fw-bold text-dark">
                                @Html.DisplayFor(m => item.StudentName)
                            </td>
                            <td>
                                <span class="badge bg-light text-dark border px-2 py-1">
                                    @Html.DisplayFor(m => item.SubjectName)
                                </span>
                            </td>
                            <td>
                                @if (item.Rating >= 5)
                                {
                                    <span class="badge bg-success px-2 py-1">
                                        ★★★★★ @item.Rating/5
                                    </span>
                                }
                                else if (item.Rating == 4)
                                {
                                    <span class="badge bg-primary px-2 py-1">
                                        ★★★★☆ @item.Rating/5
                                    </span>
                                }
                                else if (item.Rating == 3)
                                {
                                    <span class="badge bg-warning text-dark px-2 py-1">
                                        ★★★☆☆ @item.Rating/5
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-danger px-2 py-1">
                                        ★☆☆☆☆ @item.Rating/5
                                    </span>
                                }
                            </td>
                            <td class="text-break text-muted">
                                @Html.DisplayFor(m => item.Comments)
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="5" class="text-center text-secondary py-5">
                            <i class="bi bi-inbox fs-2 d-block mb-2 text-muted"></i>
                            No student responses recorded yet. Be the first to provide feedback!
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="d-flex flex-wrap gap-3 mt-4 pt-3 border-top">
        <a href="@Url.Action("Create", "Feedback")" class="btn btn-brand">
            <i class="bi bi-plus-circle me-1"></i> Submit Another Response
        </a>

        <a href="@Url.Action("Index", "Feedback")" class="btn btn-outline-secondary" style="border-radius: 10px; padding: 11px 24px; font-weight: 600;">
            <i class="bi bi-house me-1"></i> Portal Dashboard
        </a>
    </div>
</div>