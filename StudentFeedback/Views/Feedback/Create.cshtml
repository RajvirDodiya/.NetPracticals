@model StudentFeedback.Models.Feedback

@{
    ViewBag.Title = "Submit Feedback";
    Layout = "~/Views/Shared/_LayoutView.cshtml";
}

<div class="page-card">
    @Html.Partial("~/Views/Shared/_StudentInfo.cshtml")

    @using (Html.BeginForm("Create", "Feedback", FormMethod.Post, new { @class = "row g-4 mt-1" }))
    {
        @Html.AntiForgeryToken()

        @Html.ValidationSummary(false, "", new { @class = "validation-summary-errors" })

        <div class="col-md-6">
            @Html.LabelFor(m => m.EnrollmentNumber, new { @class = "form-label" })
            <div class="input-group">
                <span class="input-group-text bg-light text-muted"><i class="bi bi-hash"></i></span>
                @Html.TextBoxFor(m => m.EnrollmentNumber, new
                {
                    @class = "form-control",
                    placeholder = "e.g., 92200103045"
                })
            </div>
            @Html.ValidationMessageFor(m => m.EnrollmentNumber, "", new { @class = "field-validation-error" })
        </div>

        <div class="col-md-6">
            @Html.LabelFor(m => m.StudentName, new { @class = "form-label" })
            <div class="input-group">
                <span class="input-group-text bg-light text-muted"><i class="bi bi-person"></i></span>
                @Html.TextBoxFor(m => m.StudentName, new
                {
                    @class = "form-control",
                    placeholder = "Enter your full name"
                })
            </div>
            @Html.ValidationMessageFor(m => m.StudentName, "", new { @class = "field-validation-error" })
        </div>

        <div class="col-md-6">
            @Html.LabelFor(m => m.SubjectName, new { @class = "form-label" })
            <div class="input-group">
                <span class="input-group-text bg-light text-muted"><i class="bi bi-journal-bookmark"></i></span>
                @Html.TextBoxFor(m => m.SubjectName, new
                {
                    @class = "form-control",
                    placeholder = "e.g., .NET Web Applications / Cloud Computing"
                })
            </div>
            @Html.ValidationMessageFor(m => m.SubjectName, "", new { @class = "field-validation-error" })
        </div>

        <div class="col-md-6">
            @Html.LabelFor(m => m.Rating, new { @class = "form-label" })
            <div class="input-group">
                <span class="input-group-text bg-light text-muted"><i class="bi bi-star"></i></span>
                @Html.DropDownListFor(m => m.Rating,
                    new SelectList(new[] {
                        new { Value = 5, Text = "5 - ★★★★★ (Exceptional)" },
                        new { Value = 4, Text = "4 - ★★★★☆ (Commendable)" },
                        new { Value = 3, Text = "3 - ★★★☆☆ (Satisfactory)" },
                        new { Value = 2, Text = "2 - ★★☆☆☆ (Needs Improvement)" },
                        new { Value = 1, Text = "1 - ★☆☆☆☆ (Unsatisfactory)" }
                    }, "Value", "Text"),
                    "-- Choose Rating Score --",
                    new { @class = "form-select" })
            </div>
            @Html.ValidationMessageFor(m => m.Rating, "", new { @class = "field-validation-error" })
        </div>

        <div class="col-12">
            @Html.LabelFor(m => m.Comments, new { @class = "form-label" })
            @Html.TextAreaFor(m => m.Comments, new
            {
                @class = "form-control",
                rows = 4,
                placeholder = "Share specific observations regarding teaching clarity, laboratory assignments, or topics needing review..."
            })
            <div class="form-text text-muted">Maximum 500 characters.</div>
            @Html.ValidationMessageFor(m => m.Comments, "", new { @class = "field-validation-error" })
        </div>

        <div class="col-12 d-flex flex-wrap gap-3 mt-4 pt-2 border-top">
            <button type="submit" class="btn btn-brand">
                <i class="bi bi-send-check me-1"></i> Submit Feedback
            </button>

            <a href="@Url.Action("Index", "Feedback")" class="btn btn-outline-secondary" style="border-radius: 10px; padding: 11px 24px; font-weight: 600;">
                <i class="bi bi-arrow-left me-1"></i> Cancel
            </a>
        </div>
    }
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}