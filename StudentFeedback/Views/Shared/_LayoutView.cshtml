<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewBag.Title - Student Feedback System</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
</head>
<body class="bg-light d-flex flex-column min-vh-100">
    <nav class="navbar navbar-expand-lg navbar-dark bg-primary mb-4 shadow-sm">
        <div class="container">
            <a class="navbar-brand fw-bold" href="@Url.Action("Index", "Feedback")">Marwadi University</a>
            <div class="navbar-nav">
                <a class="nav-link text-white" href="@Url.Action("Index", "Feedback")">Home</a>
                <a class="nav-link text-white" href="@Url.Action("Create", "Feedback")">Give Feedback</a>
                <a class="nav-link text-white" href="@Url.Action("List", "Feedback")">View Feedback</a>
            </div>
        </div>
    </nav>

    <div class="container mb-4 flex-grow-1">
        @RenderBody()
    </div>

    <footer class="text-center py-3 border-top bg-white text-muted">
        <p class="mb-0">Marwadi University 2026 &bull; Student Feedback System &bull; Rajvirsinh Dodiya(92400120478)</p>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @RenderSection("Scripts", required: false)
</body>
</html>