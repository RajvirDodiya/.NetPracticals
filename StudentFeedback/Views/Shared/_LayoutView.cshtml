<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewBag.Title - Marwadi University Feedback Portal</title>

    <!-- Bootstrap 5 & Bootstrap Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />

    <style>
        :root {
            --brand-primary: #0f766e;
            --brand-secondary: #0d9488;
            --brand-dark: #134e4a;
            --accent-glow: rgba(13, 148, 136, 0.15);
            --bg-body: #f0fdf4;
            --surface-card: #ffffff;
        }

        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            background: linear-gradient(180deg, #f0fdfa 0%, #f8fafc 100%);
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
            color: #1e293b;
        }

        /* Top Brand Header */
        .portal-header {
            background: linear-gradient(135deg, #134e4a 0%, #0f766e 50%, #0d9488 100%);
            color: #ffffff;
            padding: 26px 0;
            box-shadow: 0 4px 15px rgba(15, 118, 110, 0.2);
        }

        .portal-header h2 {
            margin: 0;
            font-size: 26px;
            font-weight: 700;
            letter-spacing: -0.3px;
        }

        .portal-header .tagline {
            margin: 5px 0 0;
            color: #ccfbf1;
            font-size: 0.95rem;
        }

        /* Navigation Bar */
        .portal-nav {
            background-color: #ffffff;
            border-bottom: 1px solid #e2e8f0;
            box-shadow: 0 2px 5px rgba(0, 0, 0, 0.03);
        }

        .portal-nav a {
            display: inline-flex;
            align-items: center;
            padding: 14px 18px;
            color: #475569;
            font-weight: 600;
            font-size: 0.95rem;
            text-decoration: none;
            transition: all 0.2s ease;
            border-bottom: 3px solid transparent;
        }

        .portal-nav a:hover {
            color: var(--brand-primary);
            background-color: #f0fdfa;
            border-bottom-color: var(--brand-secondary);
        }

        /* Main Section */
        .portal-main {
            flex: 1;
            padding-top: 35px;
            padding-bottom: 45px;
        }

        .page-card {
            background-color: var(--surface-card);
            padding: 35px;
            border-radius: 16px;
            box-shadow: 0 10px 30px rgba(15, 23, 42, 0.06);
            border: 1px solid #e2e8f0;
        }

        .page-heading {
            color: var(--brand-dark);
            font-weight: 700;
            font-size: 1.75rem;
            margin-bottom: 6px;
        }

        .page-subheading {
            color: #64748b;
            font-size: 1.05rem;
            margin-bottom: 25px;
        }

        /* Form elements */
        .form-label {
            color: #334155;
            font-weight: 600;
            font-size: 0.95rem;
            margin-bottom: 6px;
        }

        .form-control,
        .form-select {
            padding: 12px 14px;
            border-radius: 10px;
            border: 1px solid #cbd5e1;
            font-size: 0.95rem;
            transition: all 0.2s;
        }

        .form-control:focus,
        .form-select:focus {
            border-color: var(--brand-secondary);
            box-shadow: 0 0 0 0.25rem var(--accent-glow);
        }

        .btn-brand {
            background-color: var(--brand-primary);
            border-color: var(--brand-primary);
            color: #ffffff;
            padding: 11px 24px;
            border-radius: 10px;
            font-weight: 600;
            transition: all 0.2s ease;
        }

        .btn-brand:hover {
            background-color: var(--brand-dark);
            border-color: var(--brand-dark);
            color: #ffffff;
            transform: translateY(-1px);
            box-shadow: 0 4px 14px rgba(15, 118, 110, 0.3);
        }

        /* Feedback Table */
        .feedback-table th {
            background-color: var(--brand-dark);
            color: #ffffff;
            font-weight: 600;
            padding: 14px;
            border: none;
        }

        .feedback-table td {
            padding: 14px;
            vertical-align: middle;
        }

        /* Footer */
        .portal-footer {
            margin-top: auto;
            padding: 22px 0;
            background-color: #0f172a;
            color: #94a3b8;
            text-align: center;
            font-size: 0.9rem;
        }

        .field-validation-error {
            display: block;
            margin-top: 5px;
            color: #e11d48;
            font-size: 0.85rem;
            font-weight: 500;
        }

        .validation-summary-errors {
            background-color: #fef2f2;
            border: 1px solid #fecaca;
            border-radius: 10px;
            padding: 14px;
            color: #b91c1c;
            margin-bottom: 20px;
        }

        .validation-summary-errors ul {
            margin-bottom: 0;
            padding-left: 20px;
        }
    </style>
</head>
<body>

    <!-- Header Section -->
    <header class="portal-header">
        <div class="container d-flex flex-wrap justify-content-between align-items-center">
            <div>
                <h2><i class="bi bi-mortarboard-fill me-2 text-warning"></i>Marwadi University</h2>
                <p class="tagline">Student Course Evaluation &amp; Academic Feedback System</p>
            </div>
            <div class="d-none d-md-block text-end">
                <span class="badge bg-light text-dark px-3 py-2 rounded-pill">
                    <i class="bi bi-person-circle text-success me-1"></i>Rajvirsinh Dodiya
                </span>
            </div>
        </div>
    </header>

    <!-- Navigation Menu -->
    <nav class="portal-nav">
        <div class="container d-flex flex-wrap">
            <a href="@Url.Action("Index", "Feedback")">
                <i class="bi bi-house-door me-2"></i>Home
            </a>
            <a href="@Url.Action("Create", "Feedback")">
                <i class="bi bi-pencil-square me-2"></i>Submit Feedback
            </a>
            <a href="@Url.Action("List", "Feedback")">
                <i class="bi bi-table me-2"></i>Review All Feedbacks
            </a>
        </div>
    </nav>

    <!-- Main Dynamic Body -->
    <main class="portal-main">
        <div class="container">
            @RenderBody()
        </div>
    </main>

    <!-- Footer -->
    <footer class="portal-footer">
        <div class="container">
            <p class="mb-0">Marwadi University 2026 &bull; Student Feedback System &bull; Rajvirsinh Dodiya</p>
        </div>
    </footer>

    <!-- Bootstrap 5 JavaScript Bundle -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @RenderSection("Scripts", required: false)

</body>
</html>