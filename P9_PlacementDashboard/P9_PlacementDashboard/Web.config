<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <connectionStrings>
    <add name="PlacementDBConnection"
         connectionString="Data Source=(LocalDB)\MSSQLLocalDB;Initial Catalog=PlacementDB;Integrated Security=True;Connect Timeout=30"
         providerName="System.Data.SqlClient" />
    <add name="PlacementDBMaster"
         connectionString="Data Source=(LocalDB)\MSSQLLocalDB;Initial Catalog=master;Integrated Security=True;Connect Timeout=30"
         providerName="System.Data.SqlClient" />
  </connectionStrings>
  <system.web>
    <compilation debug="true" targetFramework="4.8" />
    <httpRuntime targetFramework="4.8" />
    <pages controlRenderingCompatibilityVersion="4.0" clientIDMode="AutoID" />
  </system.web>
</configuration>
