@model List<Product_Catelog.Models.Product>
@{
    Layout = null;
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Product Catalog - Marwadi University</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light">
    <div class="bg-primary text-white text-center py-4 mb-4 shadow-sm">
        <h2>Product Catalog Application</h2>
        <p class="mb-0">Marwadi University &bull; ASP.NET MVC Practical</p>
    </div>

    <div class="container mb-5">
        <div class="card shadow-sm p-4 border-0">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h4 class="mb-0">Available Products</h4>
                <span class="badge bg-primary">@Model.Count Products</span>
            </div>

            <div class="table-responsive">
                <table class="table table-bordered table-hover align-middle mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th>Product ID</th>
                            <th>Product Name</th>
                            <th>Category</th>
                            <th>Price</th>
                            <th class="text-center">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var p in Model)
                        {
                            <tr>
                                <td>@p.ProductId</td>
                                <td><strong>@p.ProductName</strong></td>
                                <td><span class="badge bg-secondary">@p.ProductCategory</span></td>
                                <td class="text-success fw-bold">₹@p.ProductPrice</td>
                                <td class="text-center">
                                    @Html.ActionLink("View Details", "Details", "Products", new { id = p.ProductId }, new { @class = "btn btn-sm btn-primary" })
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <footer class="text-center py-3 border-top bg-white text-muted">
        <p class="mb-0">&copy; 2026 Marwadi University &bull; Rajvirsinh Dodiya(92400120478)</p>
    </footer>
</body>
</html>