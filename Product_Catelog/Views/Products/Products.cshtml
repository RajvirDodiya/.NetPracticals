@model List<Product_Catelog.Models.Product>

@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>PrimeTech Catalog - Product Showcase</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />

    <style>
        :root {
            --primary-accent: #2563eb;
            --primary-hover: #1d4ed8;
            --bg-canvas: #f8fafc;
            --card-shadow: 0 10px 30px rgba(15, 23, 42, 0.08);
        }

        body {
            background-color: var(--bg-canvas);
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
            color: #1e293b;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }

        .hero-banner {
            background: linear-gradient(135deg, #0f172a 0%, #1e3a8a 60%, #2563eb 100%);
            color: #ffffff;
            padding: 45px 20px;
            text-align: center;
            box-shadow: 0 6px 20px rgba(15, 23, 42, 0.2);
            margin-bottom: 35px;
        }

        .hero-banner h1 {
            font-weight: 800;
            letter-spacing: -0.5px;
            margin-bottom: 8px;
        }

        .hero-banner p {
            color: #cbd5e1;
            font-size: 1.05rem;
            margin: 0;
        }

        .content-card {
            background: #ffffff;
            border-radius: 16px;
            padding: 30px;
            box-shadow: var(--card-shadow);
            border: 1px solid #e2e8f0;
        }

        .table {
            vertical-align: middle;
            margin-bottom: 0;
        }

        .table thead th {
            background-color: #0f172a;
            color: #f8fafc;
            font-weight: 600;
            padding: 14px 18px;
            border: none;
            letter-spacing: 0.3px;
        }

        .table thead th:first-child {
            border-top-left-radius: 10px;
        }

        .table thead th:last-child {
            border-top-right-radius: 10px;
        }

        .table tbody td {
            padding: 16px 18px;
            border-bottom: 1px solid #f1f5f9;
        }

        .table tbody tr {
            transition: all 0.2s ease-in-out;
        }

        .table tbody tr:hover {
            background-color: #f8fafc;
            transform: translateY(-1px);
        }

        .thumb-preview {
            width: 52px;
            height: 52px;
            object-fit: cover;
            border-radius: 10px;
            border: 1px solid #e2e8f0;
            margin-right: 14px;
        }

        .product-title {
            font-weight: 600;
            color: #0f172a;
            margin-bottom: 2px;
        }

        .product-code {
            font-size: 0.8rem;
            color: #64748b;
        }

        .price-tag {
            font-weight: 700;
            color: #059669;
            font-size: 1.05rem;
        }

        .btn-view-details {
            background-color: var(--primary-accent);
            border-color: var(--primary-accent);
            color: white;
            border-radius: 20px;
            padding: 7px 18px;
            font-size: 0.875rem;
            font-weight: 600;
            transition: all 0.2s ease;
        }

        .btn-view-details:hover {
            background-color: var(--primary-hover);
            border-color: var(--primary-hover);
            color: white;
            transform: translateY(-2px);
            box-shadow: 0 4px 12px rgba(37, 99, 235, 0.3);
        }

        .page-footer {
            margin-top: auto;
            text-align: center;
            padding: 25px 0;
            color: #64748b;
            font-size: 0.9rem;
            border-top: 1px solid #e2e8f0;
            background: #ffffff;
        }
    </style>
</head>
<body>

    <header class="hero-banner">
        <div class="container">
            <h1><i class="bi bi-cpu me-2"></i>PrimeTech Electronics</h1>
            <p>Curated catalog of premium hardware, computing, and smart devices</p>
        </div>
    </header>

    <main class="container mb-5">
        <div class="content-card">
            <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 pb-2 border-bottom">
                <div>
                    <h4 class="fw-bold mb-1">Featured Inventory</h4>
                    <p class="text-muted small mb-0">Browse through our current available technology lineup</p>
                </div>
                <div class="mt-2 mt-sm-0">
                    <span class="badge bg-primary rounded-pill px-3 py-2 fs-6">
                        <i class="bi bi-box-seam me-1"></i> @Model.Count Items Available
                    </span>
                </div>
            </div>

            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead>
                        <tr>
                            <th>Product Details</th>
                            <th>Category</th>
                            <th>Availability</th>
                            <th>Price</th>
                            <th class="text-center">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>
                                    <div class="d-flex align-items-center">
                                        <img src="@item.ImageUrl" alt="@item.ProductName" class="thumb-preview" />
                                        <div>
                                            <div class="product-title">@item.ProductName</div>
                                            <div class="product-code">SKU: PRD-@item.ProductId</div>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <span class="badge bg-light text-dark border px-3 py-2 rounded-pill">
                                        @item.ProductCategory
                                    </span>
                                </td>
                                <td>
                                    @if (item.InStock)
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1 rounded-pill small">
                                            <i class="bi bi-check-circle-fill me-1"></i>In Stock
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary-subtle text-secondary px-2 py-1 rounded-pill small">
                                            Out of Stock
                                        </span>
                                    }
                                </td>
                                <td>
                                    <span class="price-tag">₹@item.ProductPrice.ToString("N0")</span>
                                </td>
                                <td class="text-center">
                                    @Html.ActionLink(
                                        "View Details",
                                        "Details",
                                        "Products",
                                        new { id = item.ProductId },
                                        new { @class = "btn btn-view-details" }
                                    )
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </main>

    <footer class="page-footer">
        <div class="container">
            <p class="mb-0">&copy; 2026 Marwadi University &bull; Product Catalog &bull; Rajvirsinh Dodiya</p>
        </div>
    </footer>

</body>
</html>