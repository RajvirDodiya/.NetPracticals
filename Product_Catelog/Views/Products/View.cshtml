@model Product_Catelog.Models.Product

@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@Model.ProductName - PrimeTech Specifications</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />

    <style>
        :root {
            --primary-accent: #2563eb;
            --bg-canvas: #f8fafc;
        }

        body {
            background-color: var(--bg-canvas);
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
            color: #1e293b;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }

        .hero-banner {
            background: linear-gradient(135deg, #0f172a 0%, #1e3a8a 60%, #2563eb 100%);
            color: #ffffff;
            padding: 35px 20px;
            text-align: center;
            box-shadow: 0 6px 20px rgba(15, 23, 42, 0.2);
            margin-bottom: 35px;
        }

        .hero-banner h1 {
            font-weight: 700;
            font-size: 1.85rem;
            margin: 0;
        }

        .product-card {
            background: #ffffff;
            border-radius: 18px;
            padding: 35px;
            max-width: 900px;
            margin: auto;
            box-shadow: 0 10px 30px rgba(15, 23, 42, 0.08);
            border: 1px solid #e2e8f0;
        }

        .product-image-container {
            border-radius: 14px;
            overflow: hidden;
            background: #f1f5f9;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.06);
        }

        .product-image {
            width: 100%;
            height: 340px;
            object-fit: cover;
            transition: transform 0.3s ease;
        }

        .product-image:hover {
            transform: scale(1.03);
        }

        .spec-item {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 12px 16px;
            background-color: #f8fafc;
            border-radius: 10px;
            margin-bottom: 10px;
            border: 1px solid #edf2f7;
        }

        .spec-label {
            color: #64748b;
            font-weight: 500;
            font-size: 0.95rem;
        }

        .spec-value {
            color: #0f172a;
            font-weight: 600;
        }

        .price-highlight {
            font-size: 1.75rem;
            font-weight: 800;
            color: #059669;
        }

        .btn-back {
            background-color: #0f172a;
            color: #ffffff;
            border-radius: 10px;
            padding: 10px 24px;
            font-weight: 600;
            text-decoration: none;
            display: inline-block;
            transition: all 0.2s ease;
        }

        .btn-back:hover {
            background-color: #1e293b;
            color: #ffffff;
            transform: translateY(-2px);
            box-shadow: 0 4px 12px rgba(15, 23, 42, 0.2);
        }

        .page-footer {
            margin-top: auto;
            text-align: center;
            padding: 25px 0;
            color: #64748b;
            font-size: 0.9rem;
            border-top: 1px solid #e2e8f0;
            background: #ffffff;
        }
    </style>
</head>
<body>

    <header class="hero-banner">
        <div class="container">
            <h1><i class="bi bi-info-circle me-2"></i>Product Specifications</h1>
        </div>
    </header>

    <main class="container mb-5">
        <div class="product-card">
            <div class="row align-items-center g-4">
                <div class="col-md-5">
                    <div class="product-image-container">
                        <img src="@Model.ImageUrl" alt="@Model.ProductName" class="product-image" />
                    </div>
                </div>

                <div class="col-md-7">
                    <div class="d-flex align-items-center gap-2 mb-2">
                        <span class="badge bg-primary px-3 py-1 rounded-pill">@Model.ProductCategory</span>
                        @if (Model.InStock)
                        {
                            <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1 rounded-pill small">
                                In Stock
                            </span>
                        }
                    </div>

                    <h2 class="fw-bold mb-3">@Model.ProductName</h2>

                    <p class="text-secondary mb-4">
                        @Model.Description
                    </p>

                    <div class="spec-item">
                        <span class="spec-label">Product Identifier (ID)</span>
                        <span class="spec-value">#@Model.ProductId</span>
                    </div>

                    <div class="spec-item">
                        <span class="spec-label">Customer Rating</span>
                        <span class="spec-value text-warning">
                            <i class="bi bi-star-fill me-1"></i> @Model.Rating / 5.0
                        </span>
                    </div>

                    <div class="spec-item">
                        <span class="spec-label">Regular Price</span>
                        <span class="price-highlight">₹@Model.ProductPrice.ToString("N0")</span>
                    </div>

                    <div class="mt-4 pt-2">
                        @Html.ActionLink(
                            "← Back to Catalog",
                            "Index",
                            "Products",
                            null,
                            new { @class = "btn-back" }
                        )
                    </div>
                </div>
            </div>
        </div>
    </main>

    <footer class="page-footer">
        <div class="container">
            <p class="mb-0">© 2026 PrimeTech Product Catalog • ASP.NET MVC Practical</p>
        </div>
    </footer>

</body>
</html>