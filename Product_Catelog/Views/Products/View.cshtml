@model Product_Catelog.Models.Product
@{
    Layout = null;
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Product Details - Marwadi University</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light">
    <div class="bg-primary text-white text-center py-4 mb-4 shadow-sm">
        <h2>Product Details</h2>
        <p class="mb-0">Marwadi University &bull; ASP.NET MVC Practical</p>
    </div>

    <div class="container mb-5">
        <div class="card shadow-sm p-4 border-0 mx-auto" style="max-width: 700px;">
            <div class="text-center mb-4">
                <img src="@Model.ImageUrl" alt="@Model.ProductName" class="img-fluid rounded border" style="max-height: 250px; object-fit: cover;" />
            </div>

            <h3 class="text-primary mb-3">@Model.ProductName</h3>
            <table class="table table-bordered">
                <tr>
                    <th style="width: 35%;">Product ID</th>
                    <td>@Model.ProductId</td>
                </tr>
                <tr>
                    <th>Category</th>
                    <td><span class="badge bg-secondary">@Model.ProductCategory</span></td>
                </tr>
                <tr>
                    <th>Price</th>
                    <td class="text-success fw-bold fs-5">₹@Model.ProductPrice</td>
                </tr>
            </table>

            <div class="mt-3">
                @Html.ActionLink("← Back to Products", "Index", "Products", null, new { @class = "btn btn-primary" })
            </div>
        </div>
    </div>

    <footer class="text-center py-3 border-top bg-white text-muted">
        <p class="mb-0">&copy; 2026 Marwadi University &bull; Rajvirsinh Dodiya(92400120478)</p>
    </footer>
</body>
</html>